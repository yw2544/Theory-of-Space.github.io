  /* QA Block Styles */
  .qa-block {
    margin-bottom: 0rem;
  }

  .qa-block:last-child {
    margin-bottom: 0;
  }

  .qa-block-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f2a60;
    margin: 0 0 0.75rem 0;
  }

  .qa-bullet {
    font-size: 1.2rem;
    line-height: 1;
    color: #2a2f6c;
  }

  .qa-block-label {
    letter-spacing: 0.2px;
  }

  .qa-block-content {
    padding: 1rem 2rem;
  }

  .qa-block-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .qa-block-list li {
    position: relative;
    padding-left: 1.5rem;
    color: #2e2e2e;
    line-height: 1.7;
    font-size: 1.2rem;
  }

  .qa-block-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #2a2f6c;
