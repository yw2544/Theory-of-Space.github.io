  }

  .repo-stats {
    display: flex;
    gap: 16px;
    padding-left: 16px;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: white;
    font-size: 16px;
  }

  .stat-item svg {
    fill: currentColor;
  }

  .main-subtitle {
    max-width: 800px;
    margin: 20px auto 0;
