  @media (max-width: 768px) {
    .qa-gap-figures {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .qa-figure {
      margin-top: 1.5rem;
    }

    .qa-caption {
      font-size: 0.85rem;
      padding: 0 1rem;
    }
  }
</style> 

