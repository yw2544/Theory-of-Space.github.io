    fill: currentColor;
  }

  .main-subtitle {
    max-width: 800px;
    margin: 20px auto 0;
    color: #555;
    font-size: 18px;
    line-height: 1.6;
    text-align: center;
    font-weight: 400;
  }

  .vagen-announcement {
    color: #2a2f6c;
    font-size: 0.9em;
